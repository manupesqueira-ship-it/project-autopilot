# Project Autopilot — cycle timer template
# This is a TEMPLATE. Do not install or enable directly.
# Replace placeholders before use:
#   {{PROJECT_ID}}  — e.g. mira

[Unit]
Description=Project Autopilot timer for {{PROJECT_ID}}

[Timer]
# Run every 3 hours, with 10 minute randomized delay to avoid thundering herd
OnCalendar=*-*-* 00/3:00:00
RandomizedDelaySec=600
Persistent=true

[Install]
WantedBy=timers.target
