    },
    "A3 — Brief + Script + Image Prompts (Opus 4.6)": {
      "main": [[{ "node": "Score >= 6?", "type": "main", "index": 0 }]]
    },
    "Score >= 6?": {
      "main": [
        [
          { "node": "Extract data + flatten keyframes", "type": "main", "index": 0 },
