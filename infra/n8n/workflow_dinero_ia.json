        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'claude-sonnet-4-6', max_tokens: 4000, system: $json.data, messages: [{ role: 'user', content: 'TEMA: ' + $('Brief').first().json.tema + '\\nOPEN LOOP DEL SIGUIENTE VIDEO (para el sub del CTA): ' + $('Brief').first().json.open_loop + '\\nDATOS VERIFICADOS:\\n' + $('Brief').first().json.datos }] }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "planner1",
      "name": "Planner (Claude)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [320, 0]
    },
    {
      "parameters": {
        "jsCode": "// Parsea la respuesta del planner y FUERZA el slug = id del tema en la cola,\n// para que aprobar.py cierre ledger + cola con un solo <slug>. La VALIDACION la hace validator.py.\nconst resp = $input.first().json;\nlet txt = resp.content?.[0]?.text ?? '';\ntxt = txt.trim().replace(/^```(json)?\\s*/, '').replace(/```\\s*$/, '').trim();\nconst g = JSON.parse(txt);\ng.slug = $('Brief').first().json.slug;\nif (!g.slug || !/^[a-z0-9_]+$/.test(g.slug)) throw new Error('slug invalido (de la cola): ' + g.slug);\nreturn [{ json: { slug: g.slug, data: JSON.stringify(g, null, 2) } }];"
      },
