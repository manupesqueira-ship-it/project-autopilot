      "parameters": {
        "jsCode": "// Lee el siguiente tema PRODUCIBLE de temas_cola.json (cola.py next lo emite como JSON puro en stdout).\nconst raw = $('Siguiente tema').first().json.stdout || '';\nconst b = JSON.parse(raw.trim());\nreturn [{ json: { slug: b.slug, tema: b.tema, open_loop: b.open_loop, datos: b.datos } }];"
      },
