{
  "name": "Dinero IA — Fase 1 HITL Callback Handler",
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all"
  },
  "tags": [
    { "name": "dinero-ia" },
    { "name": "fase-1" },
    { "name": "hitl" }
  ],
  "nodes": [
    {
      "id": "00000000-0000-0000-0000-000000000001",
      "name": "Telegram Trigger (callback_query)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-1200, 0],
      "parameters": {
        "updates": ["callback_query"],
        "additionalFields": {}
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      },
      "notes": "Escucha solo callback_query — los botones inline_keyboard. Para edits texto libre, se usa otro workflow."
    },
    {
      "id": "00000000-0000-0000-0000-000000000002",
      "name": "Parse callback_data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-960, 0],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const cb = $input.item.json.callback_query || $input.item.json;\nconst data = cb.data || '';\nconst [action, brief_id] = data.split(':');\nreturn {\n  callback_query_id: cb.id,\n  action,\n  brief_id,\n  chat_id: cb.message?.chat?.id || cb.from?.id,\n  message_id: cb.message?.message_id,\n  user_id: cb.from?.id,\n  user_username: cb.from?.username\n};"
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000003",
      "name": "Answer callback (Telegram)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-720, -200],
      "parameters": {
        "resource": "callback",
        "operation": "answerQuery",
        "queryId": "={{ $json.callback_query_id }}",
        "additionalFields": {
          "text": "=Acción recibida: {{ $json.action }}",
          "showAlert": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      },
      "notes": "Required by Telegram API — sin esto el botón queda 'loading' en la UI"
    },
    {
      "id": "00000000-0000-0000-0000-000000000004",
      "name": "Lookup brief en Supabase",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [-720, 0],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/briefs_pending?id=eq.{{ $('Parse callback_data').item.json.brief_id }}&select=*",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        },
        "options": { "response": { "response": { "responseFormat": "json" } } }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000005",
      "name": "Brief found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [-500, 0],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "found-cond",
              "leftValue": "={{ Array.isArray($json) && $json.length > 0 }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true" }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000006",
      "name": "Brief not found notice",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-260, 200],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parse callback_data').item.json.chat_id }}",
        "text": "=⚠️ Brief no encontrado (id: {{ $('Parse callback_data').item.json.brief_id }}). Probablemente expiró o se borró.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000007",
      "name": "Switch action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-260, 0],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "approve",
                    "leftValue": "={{ $('Parse callback_data').item.json.action }}",
                    "rightValue": "approve",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "approve"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "edit",
                    "leftValue": "={{ $('Parse callback_data').item.json.action }}",
                    "rightValue": "edit",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "edit"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "regen",
                    "leftValue": "={{ $('Parse callback_data').item.json.action }}",
                    "rightValue": "regen",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "regen"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
                "conditions": [
                  {
                    "id": "reject",
                    "leftValue": "={{ $('Parse callback_data').item.json.action }}",
                    "rightValue": "reject",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "outputKey": "reject"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000008",
      "name": "Mark approved + trigger fanout",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, -300],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/briefs_pending?id=eq.{{ $('Parse callback_data').item.json.brief_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"approval_status\": \"approved\",\n  \"approved_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": { "response": { "response": { "responseFormat": "json" } } }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000009",
      "name": "Trigger fanout webhook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, -300],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_FANOUT_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"brief_id\": \"{{ $('Parse callback_data').item.json.brief_id }}\",\n  \"action\": \"approved\",\n  \"triggered_by\": \"hitl_telegram\",\n  \"triggered_at\": \"{{ new Date().toISOString() }}\"\n}",
        "options": {
          "response": { "response": { "neverError": true, "responseFormat": "json" } }
        }
      },
      "notes": "URL del Webhook Trigger del workflow dinero-ia-fase1-fanout.json. Configurar via env var."
    },
    {
      "id": "00000000-0000-0000-0000-000000000010",
      "name": "Notify approved",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [480, -300],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parse callback_data').item.json.chat_id }}",
        "text": "=✅ *Aprobado.* Iniciando publicación a IG + TikTok + LinkedIn + Newsletter.\n\nVas a recibir notificación cuando el fanout termine (esperable 3-8 min).",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000011",
      "name": "Mark editing + ask feedback",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, -100],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/briefs_pending?id=eq.{{ $('Parse callback_data').item.json.brief_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"approval_status\": \"edited\",\n  \"edit_iterations\": {{ ($('Lookup brief en Supabase').item.json[0] || $('Lookup brief en Supabase').item.json).edit_iterations + 1 }}\n}"
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000012",
      "name": "Ask feedback text",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [240, -100],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parse callback_data').item.json.chat_id }}",
        "text": "=✏️ *Editar brief {{ $('Parse callback_data').item.json.brief_id }}*\n\nRespondé este mensaje con texto libre describiendo qué ajustar.\n\nEjemplos:\n• \"El hook está flojo, hacelo más viral pero sin perder body sobrio\"\n• \"Agregar más contexto sobre inflación AR en datos_clave\"\n• \"El disclaimer es muy largo, hacelo más corto\"\n\n⚠️ Límite: max 2 ediciones por brief (esta es la edición {{ ($('Lookup brief en Supabase').item.json[0] || $('Lookup brief en Supabase').item.json).edit_iterations + 1 }}/2).",
        "additionalFields": {
          "parse_mode": "Markdown",
          "reply_markup": "={{ JSON.stringify({ force_reply: true, input_field_placeholder: 'Tu feedback sobre el brief...' }) }}"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      },
      "notes": "force_reply hace que Telegram muestre prompt de reply al user. El workflow dinero-ia-fase1-editor.json escucha el reply."
    },
    {
      "id": "00000000-0000-0000-0000-000000000013",
      "name": "Trigger regen A3",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 100],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.N8N_REGEN_WEBHOOK_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Content-Type", "value": "application/json" },
            { "name": "X-Webhook-Secret", "value": "={{ $env.N8N_WEBHOOK_SECRET }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"brief_id\": \"{{ $('Parse callback_data').item.json.brief_id }}\",\n  \"action\": \"regenerate\",\n  \"temperature_bump\": 0.1\n}",
        "options": {
          "response": { "response": { "neverError": true, "responseFormat": "json" } }
        }
      },
      "notes": "Webhook al workflow editor.json que re-corre A3 con temperature +0.1 para variar output."
    },
    {
      "id": "00000000-0000-0000-0000-000000000014",
      "name": "Notify regen",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [240, 100],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parse callback_data').item.json.chat_id }}",
        "text": "=🔁 *Regenerando A3 Editorial...*\n\nTemperature +0.1. Vas a recibir nuevo preview en ~30-60 segundos.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000015",
      "name": "Mark rejected",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 300],
      "parameters": {
        "method": "PATCH",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/briefs_pending?id=eq.{{ $('Parse callback_data').item.json.brief_id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"approval_status\": \"rejected\",\n  \"approved_at\": \"{{ new Date().toISOString() }}\"\n}"
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000016",
      "name": "Notify rejected",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [240, 300],
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $('Parse callback_data').item.json.chat_id }}",
        "text": "=❌ *Pieza rechazada.* Marcada como rejected en Supabase, no se publica.\n\nSi querés ver otra opción, ejecutá manualmente el workflow `dinero-ia-fase1-publish.json` para procesar otra fuente.",
        "additionalFields": { "parse_mode": "Markdown" }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ME_TELEGRAM_CRED_ID",
          "name": "Telegram Bot — Dinero IA"
        }
      }
    },
    {
      "id": "00000000-0000-0000-0000-000000000017",
      "name": "Audit log event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/audit_log",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"event_type\": \"hitl_decision\",\n  \"brief_id\": \"{{ $('Parse callback_data').item.json.brief_id }}\",\n  \"actor\": \"telegram_user_{{ $('Parse callback_data').item.json.user_username || $('Parse callback_data').item.json.user_id }}\",\n  \"payload\": {\n    \"action\": \"{{ $('Parse callback_data').item.json.action }}\",\n    \"chat_id\": {{ $('Parse callback_data').item.json.chat_id }},\n    \"message_id\": {{ $('Parse callback_data').item.json.message_id }}\n  }\n}",
        "options": {
          "response": { "response": { "neverError": true, "responseFormat": "json" } }
        }
      },
      "notes": "Audit trail event_sourcing — toda decisión HITL queda registrada inmutable."
    }
  ],
