# infra/distribution/.env  -> COPIAR este archivo a ".env" y rellenar.
# .env esta gitignored: NUNCA se commitea. Claude lee estos valores pero NUNCA los imprime.
# Setup de una sola vez (OAuth/app de Meta, flujo "Instagram login" SIN Facebook):
# 1) pega IG_APP_SECRET + IG_SHORT_TOKEN (ver cabecera de ig_setup.py)
# 2) corre `python ig_setup.py` -> el rellena IG_USER_ID + IG_ACCESS_TOKEN (largo ~60d) solo.
IG_APP_SECRET=
IG_SHORT_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=

# Host publico del MP4 (Supabase Storage). Setup de una sola vez: ver cabecera de upload_supabase.py.
# SUPABASE_URL ya esta fijo al proyecto reactivado; SUPABASE_SERVICE_KEY = service_role secret (dashboard -> Settings -> API).
SUPABASE_URL=https://raacvxndaveidgaqkznh.supabase.co
SUPABASE_SERVICE_KEY=

