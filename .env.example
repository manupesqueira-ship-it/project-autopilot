# ─────────────────────────────────────────────────────────────────────
# Dinero IA — variables de entorno (template)
# ─────────────────────────────────────────────────────────────────────
# Copiá este archivo como .env y llená los valores reales.
# .env está en .gitignore — NUNCA commitearlo.
# Tu .env actual ya tiene ANTHROPIC_API_KEY del proyecto previo.
#
# Variables por fase:
#   - REQUIRED Fase 0 smoke: Anthropic + Telegram (TOKEN + CHAT_ID)
#   - REQUIRED Fase 1: + Supabase + Beehiiv + ContentStudio + Blotato + Webhook
#   - OPCIONAL: OpenAI (backup visual), n8n env vars
# ─────────────────────────────────────────────────────────────────────

# ─── REQUIRED Fase 0 smoke test ──────────────────────────────────────
# Anthropic (Opus 4 + Sonnet 4.5)
# Console: console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxx

# Telegram bot (via @BotFather)
# - TOKEN: dado por BotFather al crear el bot
# - CHAT_ID: el ID numérico de TU usuario Telegram (vía @userinfobot)
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=123456789

# ─── OPCIONAL Fase 0 (backup visual) ─────────────────────────────────
# OpenAI gpt-image-2 (solo si Blotato falla en Fase 1)
# Platform: platform.openai.com → API Keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxx

# ─── REQUIRED Fase 1 — Supabase ──────────────────────────────────────
# Supabase Free tier
# Dashboard: supabase.com → tu proyecto → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJxxxxxxxxxxxxxxxxxx

# ─── REQUIRED Fase 1 — SaaS publishing ───────────────────────────────
# ContentStudio Standard ($19/mo)
# Dashboard: contentstudio.io → Settings → API
CONTENT_STUDIO_API_KEY=cs_xxxxxxxxxxxxxxxxxx

# Blotato Starter ($29/mo)
# Dashboard: blotato.com → Settings → API
BLOTATO_API_KEY=blt_xxxxxxxxxxxxxxxxxx

# Beehiiv Launch (free hasta 2,500 subs)
# Dashboard: beehiiv.com → Settings → Integrations → API
BEEHIIV_API_KEY=bv_xxxxxxxxxxxxxxxxxx
BEEHIIV_PUBLICATION_ID=pub_xxxxxxxxxxxxxxxxxx

# ─── REQUIRED Fase 1 — n8n webhook coordination ──────────────────────
# URL del webhook trigger del workflow fanout (se genera al activar el wf)
# Format: https://{tu-instancia}.app.n8n.cloud/webhook/dinero-ia-fanout
N8N_FANOUT_WEBHOOK_URL=https://xxxxxxxx.app.n8n.cloud/webhook/dinero-ia-fanout

# Secret aleatorio para anti-spoofing entre workflows
# Generá con: openssl rand -base64 32  (o cualquier string random largo)
N8N_WEBHOOK_SECRET=cambiar_por_string_random_largo_de_32_chars
