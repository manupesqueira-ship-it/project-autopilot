# Project Autopilot — cycle service template
# This is a TEMPLATE. Do not install or enable directly.
# Replace placeholders before use:
#   {{PROJECT_ID}}  — e.g. mira
#   {{WORKDIR}}     — e.g. /root/project-autopilot
#   {{PYTHON_BIN}}  — e.g. /root/project-autopilot/venv/bin/python
#   {{COMMAND}}     — e.g. --cycle or --local-plan
#   {{USER}}        — e.g. autopilot or root

[Unit]
Description=Project Autopilot cycle for {{PROJECT_ID}}
After=network.target

[Service]
Type=oneshot
User={{USER}}
WorkingDirectory={{WORKDIR}}
ExecStart={{PYTHON_BIN}} -B project_autopilot/agent_loop.py --project {{PROJECT_ID}} {{COMMAND}}
TimeoutStartSec=600
StandardOutput=append:{{WORKDIR}}/logs/pa-{{PROJECT_ID}}-cycle.log
StandardError=append:{{WORKDIR}}/logs/pa-{{PROJECT_ID}}-cycle.log

# Safety: do not restart on failure — wait for next timer tick
Restart=no

[Install]
WantedBy=multi-user.target
